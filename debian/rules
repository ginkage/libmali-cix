#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- --sysconfdir=/etc

# private libraries in <libdir>/mali: no shlibs file, no ldconfig trigger
override_dh_makeshlibs:

override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/libmali-cix/usr/lib/$(DEB_HOST_MULTIARCH)/mali -- --ignore-missing-info

# the libmali blob is shipped as Arm/CIX built it
override_dh_strip:
	dh_strip -Xlibmali.so
override_dh_dwz:
	dh_dwz -Xlibmali.so
